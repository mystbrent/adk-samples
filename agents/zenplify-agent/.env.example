# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/zenplify_agent
PGVECTOR_ENABLED=true

# LLM Configuration
LLM_PROVIDER=google  # google, openai, anthropic, etc.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json  # For Google Vertex AI
GEMINI_MODEL=gemini-1.5-pro  # Model for LLM queries
GEMINI_EMBEDDING_MODEL=textembedding-gecko  # Model for embeddings

# GitHub API
GITHUB_APP_ID=your_app_id  # Optional if using GitHub App
GITHUB_APP_PRIVATE_KEY_PATH=/path/to/private_key.pem  # Optional if using GitHub App

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Security
JWT_SECRET=your_jwt_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging
LOG_LEVEL=INFO

# ADK Configuration 
ADK_SESSION_SERVICE=database  # in-memory, database, vertex-ai
ADK_MEMORY_SERVICE=database  # in-memory, database, custom 